# NOTE: keep DOMAINS in sync with the server blocks in nginx/conf.d/*.conf.
# - domain in DOMAINS but no server block -> certbot webroot challenge 404s
# - server block but domain not in DOMAINS -> nginx fails to start (no cert)
DOMAINS=misbot-dev.minecraftislife.online,misbot-prod.minecraftislife.online

# STAGING=1 issues from the Let's Encrypt staging CA (untrusted certs, safe
# for testing). Set to 0 for real certs — the certbot entrypoint detects the
# switch and forces a reissue against the right ACME server automatically.
STAGING=1